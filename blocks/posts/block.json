{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "house-theme/posts",
    "version": "0.1.0",
    "title": "Posts",
    "category": "design",
    "icon": "smiley",
    "description": "Display selected posts.",
    "example": {},
    "supports": {
        "html": false
    },
    "attributes": {
        "postType": {
            "type": "string",
            "default": ""
        },
        "postCount": {
            "type": "number",
            "default": 5
        }
    },
    "textdomain": "house-theme",
    "render": "file:./render.php",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./editor.css",
    "style": "file:./style.css",
    "viewScript": "file:./view.js"
}
