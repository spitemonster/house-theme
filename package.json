{
    "scripts": {
        "watch": "npm run clean && npm run rollup:watch",
        "dev": "npm run clean && npm run rollup:dev",
        "production": "npm run clean && npm run rollup:prod",
        "rollup:prod": "cross-env NODE_ENV=production rollup -c ./rollup.config.mjs",
        "rollup:dev": "rollup -c ./rollup.config.mjs",
        "rollup:watch": "rollup -c ./rollup.config.mjs -w",
        "clean": "rm -rf ./assets/blocks/ && rm -rf ./assets/css && rm -rf ./assets/js",
        "create-block": "npx hygen block new"
    },
    "devDependencies": {
        "@babel/core": "^7.24.4",
        "@babel/plugin-transform-runtime": "^7.26.8",
        "@babel/preset-env": "^7.24.4",
        "@babel/preset-react": "^7.24.1",
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-replace": "^6.0.2",
        "@rollup/plugin-terser": "^0.4.4",
        "@wordpress/blocks": "^14.3.0",
        "@wordpress/i18n": "^5.14.0",
        "autoprefixer": "^10.4.19",
        "cross-env": "^10.1.0",
        "dotenv": "^17.2.3",
        "fast-glob": "^3.3.3",
        "postcss-import": "^16.1.0",
        "postcss-nesting": "^12.1.2",
        "postcss-scss": "^4.0.9",
        "rollup": "^4.29.1",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-postcss": "^4.0.2",
        "rollup-plugin-watch": "^1.0.4",
        "rollup-plugin-wp-resolve": "^1.0.9"
    },
    "dependencies": {
        "blaze-slider": "^1.9.3"
    }
}
